#!/bin/sh
# windows-keys links into C:\Users\FilipM\Desktop\Keys; git cannot follow a symlink, so only a copy can be tracked.
cd "$(git rev-parse --show-toplevel)" || exit 0
src=windows-keys
dst=windows-keys-mirror
[ -d "$src" ] || exit 0

mkdir -p "$dst"
tar -C "$src" --exclude=./.claude -cf - . | tar -C "$dst" -xf -
(cd "$dst" && find . -type f) | while read -r f; do
    [ -e "$src/$f" ] || rm -- "$dst/$f"
done

git add -- "$dst"
git add -u -- "$dst"

fw=keyboard/voyager/firmware
if [ -f "$fw/scripts/bindings.py" ] && [ -f "$src/hotkeys-and-remaps.ahk" ]; then
    python3 "$fw/scripts/bindings.py" "$fw/keymap/keymap.c" --config "$fw/keymap/config.h" \
        --titles /mnt/c/Users/FilipM/AppData/Local/voyager/oryx-layout.json \
        --ahk "$src/hotkeys-and-remaps.ahk" > keyboard/voyager/BINDINGS.md.tmp \
        && mv keyboard/voyager/BINDINGS.md.tmp keyboard/voyager/BINDINGS.md \
        && git add -- keyboard/voyager/BINDINGS.md
fi
