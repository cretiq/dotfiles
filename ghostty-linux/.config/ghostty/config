# Ghostty on Linux (Ubuntu). Keys mirror the old Windows Terminal setup (windows-terminal/settings.json).
# The Mac config lives in ghostty/ (cmd keys); this file is the Linux one.

theme = Banana Blueberry
font-family = "JetBrains Mono"
font-size = 10
bold-color = bright
cursor-style = block
cursor-style-blink = false
adjust-cursor-thickness = 2
unfocused-split-opacity = 0.85
unfocused-split-fill = 363636
split-divider-color = 6272a4
window-padding-x = 8
window-padding-y = 8
confirm-close-surface = false
desktop-notifications = false
app-notifications = no-clipboard-copy
copy-on-select = false
clipboard-paste-protection = false

# Copy / paste: Ctrl+C copies when text is selected, otherwise it interrupts
keybind = performable:ctrl+c=copy_to_clipboard
keybind = performable:ctrl+v=paste_from_clipboard
keybind = ctrl+shift+insert=paste_from_clipboard
keybind = ctrl+shift+f=start_search

# Editing
keybind = ctrl+backspace=text:\x17
keybind = shift+enter=text:\n
keybind = ctrl+shift+l=clear_screen

# Splits (panes)
keybind = alt+shift+d=new_split:right
keybind = alt+minus=new_split:down
keybind = alt+plus=new_split:right
keybind = ctrl+shift+w=close_surface

# Move between splits. performable: only taken when a split exists that way,
# otherwise the key reaches the shell (Ctrl+L clear, Ctrl+K kill line, ...)
keybind = performable:ctrl+j=goto_split:left
keybind = performable:ctrl+k=goto_split:down
keybind = performable:ctrl+l=goto_split:up
keybind = performable:ctrl+ö=goto_split:right
keybind = ctrl+alt+o=goto_split:right
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:up
keybind = alt+down=goto_split:down
keybind = alt+shift+left=resize_split:left,40
keybind = alt+shift+right=resize_split:right,40
keybind = alt+shift+up=resize_split:up,40
keybind = alt+shift+down=resize_split:down,40

# Tabs
keybind = ctrl+shift+t=new_tab
keybind = ctrl+t=new_tab
keybind = alt+s=previous_tab
keybind = alt+d=next_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+alt+r=prompt_tab_title
keybind = ctrl+alt+shift+g=new_tab
keybind = ctrl+alt+one=goto_tab:1
keybind = ctrl+alt+two=goto_tab:2
keybind = ctrl+alt+three=goto_tab:3
keybind = ctrl+alt+four=goto_tab:4
keybind = ctrl+alt+five=goto_tab:5

gtk-titlebar-style = tabs
gtk-toolbar-style = flat
gtk-wide-tabs = false
window-titlebar-background = #191323
window-titlebar-foreground = #cccccc

gtk-custom-css = ~/.config/ghostty/focus.css

# Per-display overrides written by display-watch
config-file = ?~/.config/ghostty/display.conf

