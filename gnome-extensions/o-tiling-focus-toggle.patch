+        const current = focused ? layer(focused) : 0;
+        for (let step = 1; step < 3; step++) {
+            const target = mru.find((win) => layer(win) === (current + step) % 3);
+            if (target) {
+                this.activate_window(target);
+                return;
+            }
+        }
