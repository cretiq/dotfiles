+        const dy = Math.round(area.height * 0.02);
+        const rect = win.rect();
+        switch (direction) {
+            case Direction.Left:
+                rect.width = Math.max(rect.width - dx, dx);
+                break;
+            case Direction.Right:
+                rect.width += dx;
+                break;
+            case Direction.Up:
+                rect.height = Math.max(rect.height - dy, dy);
+                break;
+            default:
+                rect.height += dy;
+        }
+        rect.clamp(area);
+        ext.size_signals_block(win);
+        win.move(ext, rect, () => ext.size_signals_unblock(win));
