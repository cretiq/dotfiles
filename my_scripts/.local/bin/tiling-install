#!/usr/bin/env bash
# Installs O-tiling (extensions.gnome.org pk 9875, tree tiling, Pop Shell fork) and sets the JKLÖ keymap that mirrors GlazeWM, Super instead of Alt.
# Alt+J/K/L/Ö is already Alt+arrows via keyd and Ghostty splits own Alt+arrows, so the compositor takes Super.
# Needs a GNOME Shell restart (log out and in on Wayland) the first time the extension is installed.
set -eu
uuid=o-tiling@oliwebd.github.com
dir="$HOME/.local/share/gnome-shell/extensions/$uuid"

if [ ! -d "$dir" ]; then
  tmp="$(mktemp -d)"
  curl -fsSL -o "$tmp/o.zip" "https://extensions.gnome.org/download-extension/$uuid.shell-extension.zip?version_tag=77370"
  gnome-extensions install --force "$tmp/o.zip"
  rm -rf "$tmp"
fi
# An extensions.gnome.org update replaces the extension files and drops the patches until this script runs again; then
# log out and in. Order matters: each patch applies on top of the one before it.
for p in horizontal-gap border-stacking focus-toggle no-border resize inactive-border float-on-title; do
  patch_file="$HOME/.dotfiles/gnome-extensions/o-tiling-$p.patch"
  if ! patch -d "$dir" -p1 -R -s -f --dry-run < "$patch_file" >/dev/null; then
    patch -d "$dir" -p1 -N -s < "$patch_file"
  fi
done
glib-compile-schemas "$dir/schemas"

conf="${XDG_CONFIG_HOME:-$HOME/.config}/o-tiling/config.json"
mkdir -p "$(dirname "$conf")"
[ -s "$conf" ] || echo '{"float": [], "skiptaskbarhidden": [], "log_on_focus": false}' > "$conf"
jq --argjson add '[{"class": "teams-for-linux"}, {"class": "com.gabm.satty"}, {"class": "keymapp"}, {"class": "firefox", "title": "Extension:.*Bitwarden"}]' \
  '.float = ((.float // []) + ($add - (.float // [])))' "$conf" > "$conf.tmp"
mv "$conf.tmp" "$conf"
jq --argjson add '[{"class": "vicinae"}, {"class": "teams-for-linux"}]' \
  '.float = ((.float // []) + ($add - (.float // []))) | .noborder = ((.noborder // []) + ($add - (.noborder // [])))' "$conf" > "$conf.tmp"
mv "$conf.tmp" "$conf"

add_to() {
  local key=$1 val=$2 cur
  cur="$(gsettings get org.gnome.shell "$key")"
  case "$cur" in *"'$val'"*) return ;; esac
  if [ "$cur" = "@as []" ] || [ "$cur" = "[]" ]; then cur="['$val']"; else cur="${cur%]}, '$val']"; fi
  gsettings set org.gnome.shell "$key" "$cur"
}
add_to enabled-extensions $uuid
add_to disabled-extensions tiling-assistant@ubuntu.com

o() { GSETTINGS_SCHEMA_DIR="$dir/schemas" gsettings set org.gnome.shell.extensions.o-tiling "$@"; }
g() { gsettings set "$@"; }
d() { GSETTINGS_SCHEMA_DIR="$HOME/.local/share/gnome-shell/extensions/dash-to-panel@jderose9.github.com/schemas" gsettings set org.gnome.shell.extensions.dash-to-panel "$@"; }

o focus-left "['<Super>j']"
o focus-down "['<Super>k']"
o focus-up "['<Super>l']"
o focus-right "['<Super>odiaeresis']"
o focus-toggle-floating "['<Alt>space']"

o tile-move-left-global "['<Super><Shift>j']"
o tile-move-down-global "['<Super><Shift>k']"
o tile-move-up-global "['<Super><Shift>l']"
o tile-move-right-global "['<Super><Shift>odiaeresis']"

o tile-enter "['<Super>r']"
o tile-move-left "['j', 'Left']"
o tile-move-down "['k', 'Down']"
o tile-move-up "['l', 'Up']"
o tile-move-right "['odiaeresis', 'Right']"
o tile-resize-left "['<Shift>j', '<Shift>Left']"
# o-tiling's resize-up makes the window shorter; GlazeWM's resize mode has l/up taller and k/down shorter.
o tile-resize-down "['<Shift>l', '<Shift>Up']"
o tile-resize-up "['<Shift>k', '<Shift>Down']"
o tile-resize-right "['<Shift>odiaeresis', '<Shift>Right']"
o resize-narrower "['<Super>u']"
o resize-wider "['<Super>p']"
o resize-shorter "['<Super>i']"
o resize-taller "['<Super>o']"
o tile-swap-left "[]"
o tile-swap-down "[]"
o tile-swap-up "[]"
o tile-swap-right "[]"

o tile-orientation "['<Super>v']"
o toggle-floating "['<Super>t']"
o toggle-tiling "['<Super><Shift>t']"
o toggle-stacking-global "[]"

o pop-workspace-up "[]"
o pop-workspace-down "[]"
o pop-monitor-left "['<Super><Shift><Control>j']"
o pop-monitor-down "['<Super><Shift><Control>k']"
o pop-monitor-up "['<Super><Shift><Control>l']"
o pop-monitor-right "['<Super><Shift><Control>odiaeresis']"

o gap-inner 4
o gap-outer 4
o hint-color-rgba "'rgb(0,200,255)'"
o active-hint-border-width 1
o inactive-hint true
o inactive-hint-color-rgba "'rgb(161,161,161)'"

media=org.gnome.settings-daemon.plugins.media-keys
cycle_path=/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/tiling-cycle-width/
list="$(gsettings get $media custom-keybindings)"
case "$list" in
  *"'$cycle_path'"*) ;;
  "@as []" | "[]") gsettings set $media custom-keybindings "['$cycle_path']" ;;
  *) gsettings set $media custom-keybindings "${list%]}, '$cycle_path']" ;;
esac
g "$media.custom-keybinding:$cycle_path" name "Tiling cycle width"
g "$media.custom-keybinding:$cycle_path" command "$HOME/.local/bin/tiling-cycle-width"
g "$media.custom-keybinding:$cycle_path" binding "<Super>c"

g org.gnome.mutter dynamic-workspaces false
g org.gnome.desktop.wm.preferences num-workspaces 9
g org.gnome.desktop.wm.keybindings activate-window-menu "[]"
g org.gnome.desktop.wm.keybindings toggle-fullscreen "['<Super>f']"
g org.gnome.desktop.wm.keybindings close "['<Alt>F4', '<Super><Shift>q']"
g org.gnome.settings-daemon.plugins.media-keys screensaver "['<Control><Super>l']"
g org.gnome.shell.keybindings toggle-message-tray "['<Super>m']"
# Super+P/O/I belong to the direct resize keys above (GlazeWM alt+p/o/i); single external monitor, no rotation sensor in use.
g org.gnome.mutter.keybindings switch-monitor "['XF86Display']"
g org.gnome.settings-daemon.plugins.media-keys rotate-video-lock-static "['XF86RotationLockToggle']"
d intellihide-key-toggle "[]"
for n in 1 2 3 4 5 6 7 8 9; do
  g org.gnome.shell.keybindings switch-to-application-$n "[]"
  d app-hotkey-$n "[]"
  d app-shift-hotkey-$n "[]"
  d app-hotkey-kp-$n "[]"
  d app-shift-hotkey-kp-$n "[]"
done
